#!/usr/bin/env python3
"""Run burn straight from a checkout (no install needed).

Symlink this file into your PATH:  ln -sf "$PWD/bin/burn" ~/.local/bin/burn
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from burn_cli import main  # noqa: E402

if __name__ == "__main__":
    main()
