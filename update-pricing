#!/usr/bin/env python3
"""Fetch Claude model pricing from LiteLLM and write pricing.json."""

import json
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

LITELLM_URL = (
    "https://raw.githubusercontent.com/BerriAI/litellm/main"
    "/model_prices_and_context_window.json"
)
PRICING_FILE = Path(__file__).resolve().parent / "pricing.json"


def fetch(url, timeout=15):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return json.loads(resp.read())
    except Exception as e:
        print(f"error: fetch failed — {e}", file=sys.stderr)
        sys.exit(1)


def to_per_million(v):
    return round(v * 1_000_000, 6) if v is not None else None


def main():
    print(f"fetching {LITELLM_URL} ...")
    data = fetch(LITELLM_URL)

    fresh = {}
    skipped = []

    for key, entry in data.items():
        if not key.startswith("claude"):
            continue
        if not isinstance(entry, dict):
            continue
        # Skip entries with junk suffixes that would never match a real model string
        if key.endswith("-v1:0") or "@" in key:
            continue

        inp = entry.get("input_cost_per_token")
        out = entry.get("output_cost_per_token")
        if inp is None or out is None:
            skipped.append(key)
            continue

        fresh[key] = {
            "input":       to_per_million(inp),
            "output":      to_per_million(out),
            "cache_write": to_per_million(entry.get("cache_creation_input_token_cost")),
            "cache_read":  to_per_million(entry.get("cache_read_input_token_cost")),
        }

    # Load existing file
    existing = {}
    if PRICING_FILE.exists():
        try:
            existing = json.loads(PRICING_FILE.read_text())
        except json.JSONDecodeError:
            pass

    # Separate metadata keys from model entries
    old_models = {k: v for k, v in existing.items() if not k.startswith("_")}

    # Show diff before writing
    added   = sorted(set(fresh) - set(old_models))
    removed = sorted(set(old_models) - set(fresh))
    changed = sorted(k for k in set(fresh) & set(old_models) if fresh[k] != old_models[k])

    if added or removed or changed:
        print("changes:")
        for k in added:
            p = fresh[k]
            print(f"  + {k}  input={p['input']}  output={p['output']}")
        for k in removed:
            print(f"  - {k}")
        for k in changed:
            old, new = old_models[k], fresh[k]
            fields = [
                f"{f}: {old.get(f)} → {new.get(f)}"
                for f in ("input", "output", "cache_write", "cache_read")
                if old.get(f) != new.get(f)
            ]
            print(f"  ~ {k}  {', '.join(fields)}")
    else:
        print("no changes")

    # Merge: start with all existing entries (preserves manually added models),
    # then let fresh data win on key conflicts.
    merged = dict(existing)
    merged.update(fresh)
    merged["_updated"] = datetime.now(tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    merged["_source"] = LITELLM_URL

    PRICING_FILE.write_text(json.dumps(merged, indent=2, sort_keys=True) + "\n")

    print(f"wrote {len(fresh)} models to {PRICING_FILE}")
    if skipped:
        print(f"skipped {len(skipped)} entries missing input/output cost")


if __name__ == "__main__":
    main()
